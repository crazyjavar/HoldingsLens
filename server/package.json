{
  "name": "holdings-server",
  "version": "1.0.0",
  "description": "持仓明细服务 - Bun + Hono + SQLite + TypeScript",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "start": "bun server.ts",
    "dev": "bun --watch server.ts",
    "build": "bun --bun tsc -p tsconfig.build.json",
    "start:prod": "bun dist/server.js",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test tests"
  },
  "dependencies": {
    "@hono/bun": "^1.0.0",
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^22.15.0",
    "@types/bun": "^1.3.0"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  }
}
